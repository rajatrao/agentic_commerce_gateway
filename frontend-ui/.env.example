# frontend-ui local configuration (copy to .env). `shopify app dev` injects the Shopify vars.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,read_inventory,read_themes,write_draft_orders,read_shipping,read_orders

# Same database as backend-engine; Prisma uses its own schema.
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway?schema=shopify_app

# Where frontend-ui reaches backend-engine (server-to-server only).
BACKEND_INTERNAL_URL=http://localhost:8000
# Public URL agents use to reach backend-engine (shown on the Agent access page)
BACKEND_PUBLIC_URL=http://localhost:8000

# Ed25519 private key (PEM; literal \n allowed). Generate with `make keys` at the repo root.
JWT_PRIVATE_KEY=

# Verifies backend-engine's calls to /internal/admin-token (from `make keys`).
BACKEND_JWT_PUBLIC_KEY=
