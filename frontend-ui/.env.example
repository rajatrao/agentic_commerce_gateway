# frontend-ui settings for `npm run dev` (shopify app dev). `make keys` creates frontend-ui/.env
# from this file and fills in the two keys. The Shopify CLI provides SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES itself.

# Same database as backend-engine; Prisma uses its own schema.
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway?schema=shopify_app

# Where frontend-ui reaches backend-engine (server-to-server only).
BACKEND_INTERNAL_URL=http://localhost:8000
# Public URL agents use to reach backend-engine (shown on the Agent access page)
BACKEND_PUBLIC_URL=http://localhost:8000

# Signs frontend-ui's calls to backend-engine (filled in by `make keys`).
JWT_PRIVATE_KEY=

# Verifies backend-engine's calls to /internal/admin-token (filled in by `make keys`).
BACKEND_JWT_PUBLIC_KEY=
