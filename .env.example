# Root .env is read by docker compose. Generate the keys with `make keys`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
BACKEND_JWT_PRIVATE_KEY=
BACKEND_JWT_PUBLIC_KEY=
TOKEN_ENCRYPTION_KEY=

# From your Shopify Partner app (shown by `shopify app env show` in frontend-ui/)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# Optional AI attribute enrichment. Without a provider, enrichment uses rule-based
# extraction from product text only.
#   AI_PROVIDER=anthropic          Claude; needs ANTHROPIC_API_KEY
#   AI_PROVIDER=ollama             local Ollama (`make up-ollama` runs it with qwen3:8b)
#   AI_PROVIDER=openai_compatible  any OpenAI-compatible API; set AI_BASE_URL (e.g.
#                                  https://api.example.com/v1), AI_API_KEY and AI_MODEL
# AI_MODEL defaults to claude-opus-5-5 (anthropic) or qwen3:8b (ollama).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
ANTHROPIC_API_KEY=
