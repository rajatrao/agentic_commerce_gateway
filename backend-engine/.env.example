# backend-engine local configuration (copy to .env)
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Must match frontend-ui's app credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10

# Ed25519 public key (PEM; literal \n allowed). Generate the pair with `make keys` at the repo root.
JWT_PUBLIC_KEY=

# backend-engine -> frontend-ui: Ed25519 private key and where to reach frontend-ui.
# Used to fetch fresh (auto-refreshed) Shopify offline tokens.
BACKEND_JWT_PRIVATE_KEY=
FRONTEND_INTERNAL_URL=http://localhost:3000

# Fernet key for encrypting merchants' offline tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
